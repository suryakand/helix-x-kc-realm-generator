# React is a peer dependency supplied by the consuming app; do not pull a second
# copy into this package's node_modules, it would break hooks when linked.
legacy-peer-deps=true
# Where @helix-x/* comes from. Committed, so it holds NO credential: pnpm will
# not expand ${VAR} in a project .npmrc credential (anyone who can commit could
# point it at their own registry and collect the token), and a literal one would
# end up in git.
#
# The credential goes in your user-level ~/.npmrc. With NPM_TOKEN set to the
# base64 of "user:password":
#
#   pnpm registry:login
#
# CI and the Render build run the same command; the Docker build receives
# ~/.npmrc as a BuildKit secret.
#
# Publishing ignores this line: .github/scripts/publish.mjs overrides the scope
# per target (npmjs.org, CUSTOM_REGISTRY_URL, or both).
@helix-x:registry=https://packages.allquill.com/repository/allquill-npm/