{
  "//": "Fixed part of every generated realm: permission roles (client roles of the api client), bundles, the platform-admin realm role and all client scopes. The api client is named \"acme-org-api\" here; build-realm.mjs renames it to the answers' clients.api. Copy it and pass your copy with --template to generate realms for another permission model.",
  "roles": {
    "realm": [
      {
        "name": "platform-admin",
        "description": "Super admin: every tenant, user and client",
        "composite": true,
        "composites": {
          "client": {
            "acme-org-api": [
              "platform:tenants:access",
              "platform:tenants:manage",
              "platform:users:manage",
              "platform:usage:read",
              "tenant-admin"
            ]
          }
        }
      }
    ],
    "client": {
      "acme-org-api": [
        {
          "name": "tracking:lookup",
          "description": "One-shot lookup of a container or booking number",
          "composite": false
        },
        {
          "name": "shipments:read",
          "description": "List and read tracked shipments and their events",
          "composite": false
        },
        {
          "name": "shipments:track",
          "description": "Start tracking a shipment",
          "composite": false
        },
        {
          "name": "shipments:refresh",
          "description": "Refresh a tracked shipment from the carrier now",
          "composite": false
        },
        {
          "name": "shipments:stop",
          "description": "Stop tracking a shipment",
          "composite": false
        },
        {
          "name": "vessels:read",
          "description": "Vessel registry, tracked vessels, MMSI lookup providers",
          "composite": false
        },
        {
          "name": "vessels:mmsi:manage",
          "description": "Look up and set vessel MMSIs",
          "composite": false
        },
        {
          "name": "carriers:read",
          "description": "List carriers and their status",
          "composite": false
        },
        {
          "name": "carriers:raw",
          "description": "Raw carrier responses (debugging)",
          "composite": false
        },
        {
          "name": "tenant:usage:read",
          "description": "See the tenant's usage",
          "composite": false
        },
        {
          "name": "tenant:users:read",
          "description": "List the tenant's users",
          "composite": false
        },
        {
          "name": "tenant:users:manage",
          "description": "Invite, regroup, limit, disable and remove the tenant's users",
          "composite": false
        },
        {
          "name": "tenant:clients:read",
          "description": "List the tenant's M2M clients",
          "composite": false
        },
        {
          "name": "tenant:clients:manage",
          "description": "Create, edit, rotate, disable and delete the tenant's M2M clients",
          "composite": false
        },
        {
          "name": "platform:tenants:access",
          "description": "Act in any tenant (pick it with x-tenant-id) with the caller's other permissions",
          "composite": false
        },
        {
          "name": "platform:tenants:manage",
          "description": "Create, rename and suspend tenants; see all tenants",
          "composite": false
        },
        {
          "name": "platform:users:manage",
          "description": "See every account; enable or disable accounts everywhere",
          "composite": false
        },
        {
          "name": "platform:usage:read",
          "description": "See any tenant's usage",
          "composite": false
        },
        {
          "name": "tenant-admin",
          "description": "Bundle: everything within a tenant",
          "composite": true,
          "composites": {
            "client": {
              "acme-org-api": [
                "tracking:lookup",
                "shipments:read",
                "shipments:track",
                "shipments:refresh",
                "shipments:stop",
                "vessels:read",
                "vessels:mmsi:manage",
                "carriers:read",
                "carriers:raw",
                "tenant:usage:read",
                "tenant:users:read",
                "tenant:users:manage",
                "tenant:clients:read",
                "tenant:clients:manage"
              ]
            }
          }
        },
        {
          "name": "tenant-member",
          "description": "Bundle: track and manage shipments, see usage",
          "composite": true,
          "composites": {
            "client": {
              "acme-org-api": [
                "tracking:lookup",
                "shipments:read",
                "shipments:track",
                "shipments:refresh",
                "shipments:stop",
                "vessels:read",
                "carriers:read",
                "tenant:usage:read"
              ]
            }
          }
        },
        {
          "name": "tenant-viewer",
          "description": "Bundle: read-only tracking",
          "composite": true,
          "composites": {
            "client": {
              "acme-org-api": [
                "tracking:lookup",
                "shipments:read",
                "vessels:read",
                "carriers:read"
              ]
            }
          }
        }
      ]
    }
  },
